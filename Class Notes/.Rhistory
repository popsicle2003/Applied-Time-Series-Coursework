plot(x<-filter(rnorm(5000),filter=1,method = 'recursive')) #simulate random walk starting at zero
abline(h=mean(x)) # draw sample mean as a horizontal level
#install.packages('MASS');
library('MASS')
v=2;rho=0.9 # specify marginal variance and correlation
z = mvrnorm(500, mu=c(0,0), Sigma=matrix(c(v,rho*v,rho*v,v), nrow = 2, ncol = 2)) #generate sample from bivariate normal distribution with marginal variance v (same for both components)  and correlation rho.
head(z,10) # show first 10 sample pairs
plot(z)
u=z[,1];v=z[,2]
print('sample variance')
var(u) # by default R computes sample variace/covariance by dividing by (sample size-1)
print('sample covariance')
cov(u,v)
print('sample correlation')
cor(u,v) # compute sample correlation
attributes(soi) # show attributes of the object soi.
plot(soi) # climate index
#install.packages('astsa');
library('astsa')
attributes(soi) # show attributes of the object soi.
plot(soi) # climate index
for (i in 1:s) {
# Generate random sample: returns number of "successes"
successes <- rbinom(1, n, p_true)
# Calculate Score Interval using prop.test
# (correct=FALSE gives score interval)
test_result <- prop.test(successes, n, conf.level = conf_level, correct = FALSE)
ci <- test_result$conf.int
# Check if true p is in interval
if (p_true >= ci[1] && p_true <= ci[2]) {
coverage_count <- coverage_count + 1
}
}
run_simulation <- function(s, conf_level) {
n <- 1497
p_true <- 0.53
coverage_count <- 0
for (i in 1:s) {
# Generate random sample: returns number of "successes"
successes <- rbinom(1, n, p_true)
# Calculate Score Interval using prop.test
# (correct=FALSE gives score interval)
test_result <- prop.test(successes, n, conf.level = conf_level, correct = FALSE)
ci <- test_result$conf.int
# Check if true p is in interval
if (p_true >= ci[1] && p_true <= ci[2]) {
coverage_count <- coverage_count + 1
}
}
return((coverage_count / s) * 100)
}
run_simulation <- function(s, conf_level) {
n <- 1497
p_true <- 0.53
coverage_count <- 0
for (i in 1:s) {
# Generate random sample: returns number of "successes"
successes <- rbinom(1, n, p_true)
# Calculate Score Interval using prop.test
# (correct=FALSE gives score interval)
test_result <- prop.test(successes, n, conf.level = conf_level, correct = FALSE)
ci <- test_result$conf.int
# Check if true p is in interval
if (p_true >= ci[1] && p_true <= ci[2]) {
coverage_count <- coverage_count + 1
}
}
return((coverage_count / s) * 100)
}
# Run for s = 5, 10, 100, 1000 with 95% confidence
s_values <- c(5, 10, 100, 1000)
cat("Coverage for 95% Score Intervals:\n")
for (s in s_values) {
coverage <- run_simulation(s, 0.95)
cat(sprintf("s = %d: %.1f%%\n", s, coverage))
}
#With 70% confidence
cat("\nCoverage for 70% Score Intervals:\n")
for (s in s_values) {
coverage <- run_simulation(s, 0.70)
cat(sprintf("s = %d: %.1f%%\n", s, coverage))
}
set.seed(123)
