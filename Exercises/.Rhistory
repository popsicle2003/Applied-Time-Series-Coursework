library('astsa')
attributes(soi) # show attributes of the object soi.
plot(soi) # climate index
attributes(soi_acf<- acf(soi,plot = F))
soi_acf$acf # ACF values at lag 0,1,2,..., lag.max  (if left unspecified, is given by a formula of sample size).
soi_acf$acf[2]
(r <- soi_acf$acf[-1]) # store ACF values (delete the first element which corresponds to lag 0).
lag.plot(soi,set.lags=1) #set.lags = h
legend('topleft', legend=c('correlation',r[1]))
lag.plot(soi,set.lags=5)
legend('topleft', legend=c('correlation',r[5]))
acf(soi,lag.max = 50)
acf(rnorm(1000),lag.max = 100) #sample ACF for Gaussian white noise
plot(speech)
acf(speech, 250)
set.seed(42) # Set seed for reproducibility
t <- 1:500
# Generate the signal
cs <- 2 * cos(2 * pi * t / 50 + 0.6 * pi)
# Generate the Gaussian white noise
w <- rnorm(500, mean = 0, sd = 1)
# Combine to create the signal-plus-noise model
x <- cs + w
# Plot the time series
plot.ts(x, main = "Signal-Plus-Noise Model", ylab = "x_t")
# Compute and plot the sample ACF up to lag 150
acf(x, lag.max = 150, main = "Sample ACF of Signal-Plus-Noise Model")
# Set seed for reproducibility
set.seed(42)
# Define time index
t <- 1:500
# Simulate Gaussian white noise with variance 1
w <- rnorm(500, mean = 0, sd = 1)
# Generate the signal-plus-noise series
x <- 2 * cos(2 * pi * (t + 15) / 50) + w
# Setup plot area
par(mfrow = c(2, 1))
# Plot the simulated series
plot.ts(x, main = "Simulated Signal-Plus-Noise Series", ylab = expression(x[t]), col = "darkblue")
# Compute and plot the sample ACF to lag 100
acf(x, lag.max = 100, main = "Sample ACF of Signal-Plus-Noise Series")
n <- 500
# Simulate Gaussian white noise series with n+1 for w to accommodate the lag w_{t-1}
w <- rnorm(n + 1, mean = 0, sd = 1)
u <- rnorm(n, mean = 0, sd = 1)
# Construct x_t and y_t
x <- w[2:(n + 1)]        # x_t = w_t (from t=1 to 500)
w_lag <- w[1:n]          # w_{t-1} (from t=0 to 499)
theta <- 1
y <- x - theta * w_lag + u
# Plot both series on the same graph
ts.plot(cbind(x, y), col = c("blue", "red"), lty = c(1, 2),
main = "Simulated Bivariate Time Series", ylab = "Value")
legend("topright", legend = c(expression(x[t]), expression(y[t])),
col = c("blue", "red"), lty = c(1, 2))
# Compute sample cross-correlation (suppressing the default plot)
ccf_result <- ccf(x, y, plot = FALSE)
# Extract specific lags
rho_hat_1 <- ccf_result$acf[ccf_result$lag == 1]
rho_hat_minus_1 <- ccf_result$acf[ccf_result$lag == -1]
# Display comparison
cat("Sample CCF at lag 1:      ", round(rho_hat_1, 4), "\n")
cat("Theoretical CCF at lag 1:  0.0000\n\n")
cat("Sample CCF at lag -1:     ", round(rho_hat_minus_1, 4), "\n")
cat("Theoretical CCF at lag -1:-0.5774\n")
