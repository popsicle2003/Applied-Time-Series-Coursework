w = rnorm(1000)
wd = w + 0.2
xd = filter(wd, filter=c(1), method="recursive")
plot.ts(xd, main="random walk with drift")
abline(a=0, b=.2, lty=2) #lty=2 for dashed line
cumsum(c(2,1,3,1,0))
w = rnorm(1000)
wd = w +.2
xd = cumsum(wd)
plot.ts(xd, main="random walk with drift")
abline(a=0, b=.2, lty=2)
