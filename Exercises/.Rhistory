crazy <- function(num)
{
if (num>10000)
{
print('Sample size too large. Set to 10000')
num <- 10000.
}
x <- c() # start with an empty vector
for (n in 1:num)
{
x[n] <- mean(rcauchy(n))  #rcauchy(n) generates n standard Cauchy random numbers
}
plot(x, type="l", xlab="sample size", ylab="sample mean")
}
cool <- function(num)
{
if (num>10000)
{
print('Sample size too large. Set to 10000')
num <- 10000.
}
if (num<100)
{
print('Sample size too small. Set to 100')
num <- 100.
}
x <- c() # start with an empty vector
for (n in 1:num)
{
x[n] <- median(rcauchy(n))  #rcauchy(n) generates n standard Cauchy random numbers
}
plot(x, type="l", xlab="sample size", ylab="sample mean")
}
cool(100)
cool(1000)
cool(10000)
cool(100)
cool(1000)
cool(10000)
my_ts <- ts(1:50, frequency = 12)
print(my_ts)
plot(my_ts, main = "Exercise 5: Initial Time Series", ylab = "Value", xlab = "Time")
my_ts_modified <- ts(1:50, start = c(1990, 6), frequency = 12)
print(my_ts_modified)
sub_ts <- window(my_ts_modified, start = c(1990, 12), end = c(1992, 4))
print(sub_ts)
my_ts <- ts(1:50, frequency = 12)
print(my_ts)
plot(my_ts, main = "Initial Time Series", ylab = "Value", xlab = "Time")
my_ts_modified <- ts(1:50, start = c(1990, 6), frequency = 12)
print(my_ts_modified)
plot(my_ts_modified, main = "Modified Time Series", ylab = "Value", xlab = "Time")
sub_ts <- window(my_ts_modified, start = c(1990, 12), end = c(1992, 4))
plot(sub_ts, main = "Windowed Time Series", ylab = "Value", xlab = "Time")
print(sub_ts)
install.packages("tinytex")
w=as.ts(rnorm(1000)) # generate Gaussian white noise, mean 0, variance 1
plot(w)
acf(w)
rep(1/3,3)
w = rnorm(500,0,1) # generate 500 N(0,1) random numbers
v = filter(w, sides=2, filter=rep(1/3,3)) # moving average, will elaborate on the function "filter" below.
plot.ts(w, ylim=c(-3,3), main="white noise")
plot.ts(v, ylim=c(-3,3), main="moving average")
x=c(1,2,3,4,5)
filter(x,sides=1,c(1,1,1))
filter(x,sides=2,c(1,1,1))
w = rnorm(500) # 500 N(0,1) variates
v = filter(w, sides=2, filter=c(1/2,-1,1/2)) # a "sharpening" linear filter
#par(mfrow=c(2,1))
plot.ts(w, main="white noise")
plot.ts(v, ylim=c(-3,3), main="sharpened")
w = rnorm(1000)
x = filter(w, filter=c(1,-0.9), method="recursive")
plot.ts(x, main="autoregression")
