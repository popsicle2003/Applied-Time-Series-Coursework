library(astsa)
# The dataset jj is included in astsa (or you can use base R's JohnsonJohnson)
x <- log(jj)
trend <- time(jj)
Q <- factor(cycle(jj))
# Fit the regression model without an intercept (0 + ...)
model_a <- lm(x ~ 0 + trend + Q)
summary(model_a)
